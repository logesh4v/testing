<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Online Bookstore Registration</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: linear-gradient(to right, #0066cc, #33ccff);
        }
 
        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
        }
 
        .registration-box {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
            width: 350px;
        }
 
        h2 {
            margin: 0;
            color: #333;
        }
 
        p {
            color: #666;
            margin-bottom: 20px;
        }
 
        form {
            display: flex;
            flex-direction: column;
        }
 
        label {
            text-align: left;
            margin-bottom: 5px;
            font-weight: bold;
            color: #333;
        }
 
        input {
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
        }
 
        button {
            background: #0066cc;
            color: white;
            padding: 10px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }
 
        button:hover {
            background: #004c99;
        }
 
        .login-link {
            margin-top: 15px;
            font-size: 14px;
        }
 
        .login-link a {
            color: #0066cc;
            text-decoration: none;
        }
 
        .login-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
 
<script>
function example() {
	let x=10;
	if(true) {
		let x=20;
		console.log(x);
	}
	console.log(x);
}

function example2() {
	var x=10;
	if(true) {
		var x=20;
		console.log(x);
	}
	console.log(x);
}

function example3() {
	const x=10;
	if(true) {
		x=20;
		console.log(x);
	}
	console.log(x);
}



//let name = "Tanuj";
//console.log("Hello, " + name + " Welcome");

//name = "Tanuj";
//console.log(`Hello, ${name} Welcome`);

let textt = "This is line1. \n" + "This is line2.";
console.log(textt);

text1 = `This is line1.
This is line2.`;
console.log(text1);

let product = "Laptop";
let price = 55000;
console.log(`The price of ${product} is ${price}`);

console.log("5" == 5); // true

console.log("5" === 5); // false

console.log("5" != 5); // false

console.log("5" !== 5); // true

console.log(5 > 3); // true
console.log(5 < 3); // false

console.log(5 > 3 && 5 > 2); // true

console.log(5 > 3 || 5 < 2); // true

console.log(!(5 > 3)); // false

//String methods
let text = "   Hello World   ";
console.log(text.length);
console.log(text.toUpperCase());
console.log(text.toLowerCase());
console.log(text.trim());

text = "Hello JavaScript";
console.log(text.slice(2, 10));
console.log(text.replace("Java", "Type"));

let textArray = "value1, value2, value3";
console.log(textArray.split(", "));


//Array methods
let numbers = [10, 20, 30, 40, 50];
let gadgets = ["Laptop", "Smartphone", "TV"];
console.log(gadgets[2]);

gadgets.push("Earphone");
console.log(gadgets);

gadgets.pop();
console.log(gadgets);

gadgets.shift();
console.log(gadgets);

gadgets.unshift("Mic");
console.log(gadgets);

console.log(gadgets.indexOf("Smartphone"));
console.log(gadgets.includes("Earphone"));

console.log(gadgets.slice(1, 2));

gadgets.splice(1, 2);
console.log(gadgets);

console.log(gadgets.join(" - "));

gadgets.reverse();
console.log(gadgets);

gadgets.sort();
console.log(gadgets);

gadgets.forEach(gadget => console.log(gadget));

let squaredNumbers = numbers.map(num => num * num);
console.log(squaredNumbers);


// Object with function as property
let user = {
        name: "Tanuj",
        greet: function() {
            console.log(`Hello, my name is ${this.name}`);
        }
    };

    user.greet();

    // Object Destructuring -> ES6
    let person = {
        name: "Tanuj",
        age: 25,
        city: "New Delhi"
    };

    let { name, age, city } = person;
    console.log(name); // Tanuj
    console.log(age);  // 25
    console.log(city); // ND

    // Object Spread Operator (ES6)
    let obj1 = { a: 12, b: 15 };
    let obj2 = { ...obj1, c: 20 };

    console.log(obj2); // { a: 12, b: 15, c: 20 }

    // Merging objects
    let userP = { name: "Tanuj", age: 25 };
    let userLoc = { city: "New Delhi", country: "India" };

    let userAllD = { ...userP, ...userLoc };

    console.log(userAllD); 
</script>

    <div class="container">
        <div class="registration-box">
            <h2>Registration</h2>
           <marquee> <p>Welcome to  Online Book Store</p></marquee>
            <form action="#">
                <label for="name">Full Name</label>
                <input type="text" id="name" placeholder="Enter your full name" required>
 
                <label for="email">Email</label>
                <input type="email" id="email" placeholder="Enter your email" required>
 
                <label for="password">Password</label>
                <input type="password" id="password" placeholder="Create a password" required>
 
                <label for="confirm-password">Confirm Password</label>
                <input type="password" id="confirm-password" placeholder="Confirm your password" required>
 
                <button type="submit">Register</button>
            </form>
            <p class="login-link">Already have an account? <a href="#">Login</a></p>
        </div>
    </div>
</body>
</html>


