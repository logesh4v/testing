package Junit;

import static org.junit.jupiter.api.Assertions.*;

import org.junit.jupiter.api.Test;

class CalculatorTest {

	@Test //annotation
	void testAdd() {
		Calculator calc = new Calculator();
		calc.add(5, 10);//functionality we added
		//assertions -match with the expected and actual result
		assertEquals(15,calc.add(5,10));//test case for add
	}

	@Test
	void testSub() {
		Calculator calc = new Calculator();
		
		assertEquals(-5,calc.sub(5,10));
	}
	
	@Test
	void testcondition() {
		Calculator calc = new Calculator();
		
		assertTrue(calc.add(2,9)>0);
	}
	
	
	@Test
	void testcondition1() {
		Calculator calc = new Calculator();
		
		assertTrue(calc.sub(9,8)>0);
	}
	
	@Test
	void testNull()
	{
		Calculator calc=new Calculator();
		assertNull(calc.add(null,null)); //check null case
	}
	
	@Test
	void testnotNull() {
		Calculator calc = new Calculator();
		
		assertNotNull(calc.add(2,8));
	}
	
	

}
