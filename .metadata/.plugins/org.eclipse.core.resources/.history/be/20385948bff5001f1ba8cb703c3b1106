<!DOCTYPE html>
<html lang="en">
<head>
    <title>DOM</title>
    <style>
    </style>
</head>
<body>
    <h1 id="heading">Welcome to JS</h1>
    <p class="message">This is a message needed to be printed</p>
    
    <button id="btn">Change Heading</button> 

    <script>
        function fetchData() {
            return new Promise((resolve, reject) => {
                console.log("Fetching data...");
                setTimeout(() => {
                    let success = true;
                    if (success) {
                        resolve({ name: "logesh", age: 25 }); // Fulfills
                    } else {
                        reject("Error: Failed to fetch data."); // Rejects
                    }
                }, 3000);
            });
        }

        async function getData() {
            console.log("Fetching Data . . .");
            try {
                let data = await fetchData();
                console.log("Processing Data: ", data);
                try {
                    let data2 = { ...data, city: "coimbatore" };
                    console.log("Processing updated data------", data2);
                } catch (error) {
                    console.log("Error: ", error);
                }
            } catch (error) {
                console.log("Error: ", error);
            }
        }

        getData();
        
        function fetchUserData() {
            // Get request
            fetch("https://jsonplaceholder.typicode.com/users")
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(`HTTP error: status ${response.status}`);
                    }
                    return response.json();
                })
                .then((data) => {
                    console.log("users data:", data);
                })
                .catch((error) => {
                    console.log("error:", error);
                });
        }

        fetchUserData();
        
        
        async function fetchUserData1(id) {
            try {
                const response = await fetch(`https://jsonplaceholder.typicode.com/users/${id}`);
                if (!response.ok) {
                    throw new Error(`HTTP error: status ${response.status}`);
                }
                const data = await response.json();
                console.log("Users Data: ", data);
            } catch (error) {
                console.log("Error: ", error);
            }
        }

        fetchUserData1(5);

        
        async function fetchAllUsers(userIds) {
            try {
                // Array 
                let userPromises = userIds.map((id) =>
                    fetch(`https://jsonplaceholder.typicode.com/users/${id}`)
                        .then((response) => {
                            if (!response.ok) {
                                throw new Error(`HTTP error: status ${response.status}`);
                            }
                            return response.json();
                        })
                );

                let users = await Promise.all(userPromises);
                console.log("Success: All user data fetched", users);
            } catch (error) {
                console.error("Error:", error);
            }
        }

        fetchAllUsers([9, 6, 7, 1, 5]);

        
        
        function fetchUsersData() {
            // Get request
            fetch("https://jsonplaceholder.typicode.com/users") // Provide the correct URL here
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(`HTTP error: status ${response.status}`);
                    }
                    return response.json();
                })
                .then((data) => {
                    console.log("user data:", data);
                })
                .catch((error) => {
                    console.log("error: ", error);
                });
        }

        fetchUsersData(); 
        
        
        
      //Function to create a new user---POST 
        function createUser(newUser) {
            fetch("https://jsonplaceholder.typicode.com/users", { // Replace with your actual URL
                method: "POST",
                headers: {
                    "Content-Type": "application/json" // Indicates JSON data is being sent
                },
                body: JSON.stringify(newUser) // Converts the object to a JSON string
            })
            .then(response => response.json())
            .then(data => {
                console.log("User created successfully:", data); // Success message
            })
            .catch(error => {
                console.error("Error creating user:", error); // Error handling
            });
        }
         
      
        let user = { name: "logesh", email: "logesh@gmail.com" };
        createUser(user);
        
        
    

        fetchUserData();

        async function deleteUser(userId) {
	        try {
	            let confirmation = window.confirm("Are you sure you want to delete?");
	            if (!confirmation) {
	                console.log("Deletion canceled.");
	                return;
	            }
 
	            const response = await fetch(`https://jsonplaceholder.typicode.com/users/${userId}`, {
	                method: "DELETE"
	            });
 
	            if (!response.ok) {
	                throw new Error(`HTTP error: status: ${response.status}`);
	            }
 
	            console.log(`User with ID: ${userId} deleted.`);
	        } catch (error) {
	            console.error("Error: ", error);
	        }
	    }
 
 
 
	    deleteUser(1);
        
	    
	    
	    
	    
	    
	    
	    function updateUser(id, userObject) {
	        let confirmation = window.confirm("Are you sure you want to update this user?");
	        
	        if (!confirmation) {
	            console.log("Update canceled.");
	            return;
	        }
	     
	    fetch(`https://jsonplaceholder.typicode.com/users/${id}`, {
	            method: 'PUT',
	            headers: {
	                'Content-Type': 'application/json'
	            },
	            body: JSON.stringify(userObject)
	        })
	        .then(response => response.json())
	        .then(data => console.log("User updated:", data))
	        .catch(error => console.error("Error:", error));
	    }
	     
	    // PUT
	    let userUpdate = {
	        name: "mohan",
	        email: "mohan@gmail.com",
	        city: "Theni",
	        address: "Street123test"
	    };
	    updateUser(1, userUpdate);
	     
	    //PATCH
	    function updateUserSpecific(id, partialUpdate) {
	        let confirmation = window.confirm("Are you sure you want to update specific user fields?");
	        
	        if (!confirmation) {
	            console.log("Update canceled.");
	            return;
	        }
	     
	    fetch(`https://jsonplaceholder.typicode.com/users/${id}`, {
	            method: 'PATCH',
	            headers: {
	                'Content-Type': 'application/json'
	            },
	            body: JSON.stringify(partialUpdate)
	        })
	        .then(response => response.json())
	        .then(data => console.log("User fields updated:", data))
	        .catch(error => console.error("Error:", error));
	    }
	     
	    // patch
	    let userUpdateSpecific = { name: "mohan updated", city: "theni updated" };
	    updateUserSpecific(1, userUpdateSpecific);
        
        

    </script>
</body>
</html>
