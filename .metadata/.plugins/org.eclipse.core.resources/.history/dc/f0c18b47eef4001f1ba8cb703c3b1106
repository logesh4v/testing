<script>

const hotelRooms = [
    { type: "Standard", price: 5000, available: true },
    { type: "Deluxe", price: 8000, available: true },
    { type: "Suite", price: 12000, available: false },
    { type: "Penthouse", price: 15000, available: true }
];

function findAvailableRooms(rooms, minPrice, maxPrice) {
    return rooms
        .filter(room => room.price >= minPrice && room.price <= maxPrice && room.available)
        .map(room => ({
            type: room.type,
            price: room.price
        }));
}

const availableRooms = findAvailableRooms(hotelRooms, 5000, 10000);
console.log(availableRooms);



const cartItems = [
    { name: "Laptop", price: 5000, quantity: 1 },
    { name: "Mouse", price: 300, quantity: 2 },
    { name: "Keyboard", price: 800, quantity: 1 },
    { name: "Monitor", price: 4000, quantity: 2 }
];

function generateReceipt(cart) {
    let total = 0;
    let receipt = 'Receipt:\n';
    receipt += '----------------------------------\n';

    cart.forEach(item => {
        const itemTotal = item.price * item.quantity;
        total += itemTotal;
        receipt += `${item.name} (x${item.quantity}): ₹${itemTotal.toFixed(2)}\n`;
    });

    receipt += '----------------------------------\n';
    receipt += `Total: ₹${total}`;
    return receipt;
}

const receipt = generateReceipt(cartItems);
console.log(receipt);

const student = { name: "Logesh", marks: { sci: 100, maths: 90, english: 90 } };

function generateReportCard(student) {
    const marks = student.marks;
    const totalMarks = marks.sci + marks.maths + marks.english;
    const averageMarks = totalMarks / 3;
    const percentage = (totalMarks / 300) * 100;

    return `Report Card for ${student.name}:
----------------------------------
Science: ${marks.sci}
Maths: ${marks.maths}
English: ${marks.english}
----------------------------------
Total Marks: ${totalMarks}
Average Marks: ${averageMarks}
Percentage: ${percentage}%
----------------------------------`;
}

const reportCard = generateReportCard(student);
console.log(reportCard);

   

